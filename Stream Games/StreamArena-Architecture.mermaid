flowchart TB
    subgraph KICK["KICK PLATFORM"]
        OAUTH["id.kick.com<br/>OAuth 2.1 + PKCE"]
        API["api.kick.com<br/>POST /public/v1/chat"]
        WH["Webhooks<br/>chat.message.sent<br/>subscription.* · kicks.gifted"]
    end

    subgraph WEB["WEB PROCESS — Fastify"]
        ING["Webhook Ingest<br/>verify sig → dedupe → enqueue → 200"]
        AUTH["Auth Routes<br/>PKCE · token refresh"]
        REST["Dashboard REST API"]
        WSS["WebSocket Server"]
    end

    subgraph WORKER["WORKER PROCESS — BullMQ"]
        NORM["Normalise<br/>KickEvent → InternalEvent"]
        ROUTE["Session Router<br/>active session? (fast path)"]
        PARSE["Command Parser<br/>keyword registry"]
        GUARD["Guard Chain<br/>role · cooldown · caps"]
        REG["GAME REGISTRY<br/>pure reducers"]
        EXEC["Effect Executor"]
        SEND["Chat Sender<br/>token bucket · batching · 429 backoff"]
        SUBS["Subscription Manager<br/>session-scoped · quota guard"]
    end

    subgraph GAMES["GAME MODULES — plugins"]
        G1["bonus-hunt"]
        G2["slot-battle"]
        G3["giveaway"]
        G4["predictions"]
        G5["… game N"]
    end

    subgraph DATA["DATA LAYER"]
        PG[("PostgreSQL<br/>source of truth<br/>event log + snapshots")]
        RD[("Redis<br/>hot state · queues<br/>dedupe · buckets")]
        CAT["Slot Catalog Service<br/>fuzzy match + aliases"]
    end

    OV["OBS Browser Source<br/>per-game overlay<br/>snapshot + patches"]

    WH -->|"HTTPS POST"| ING
    OAUTH <--> AUTH
    SEND -->|"chat writes"| API
    SUBS -->|"create / delete subs"| WH

    ING -->|"BullMQ"| NORM
    NORM --> ROUTE
    ROUTE -->|"no session → drop"| NORM
    ROUTE --> PARSE
    PARSE --> GUARD
    GUARD --> REG
    REG --> GAMES
    GAMES -->|"state + effects"| EXEC

    EXEC --> SEND
    EXEC -->|"append event"| PG
    EXEC -->|"project state"| RD
    EXEC -->|"lookup → re-enter"| CAT
    CAT --> PG
    EXEC -->|"broadcast patch"| RD
    RD -->|"pub/sub"| WSS
    WSS -->|"WSS + overlay token"| OV

    REST --> PG
    ROUTE --> RD

    style KICK fill:#1f2937,stroke:#4b5563,color:#f9fafb
    style WEB fill:#0f766e,stroke:#14b8a6,color:#f0fdfa
    style WORKER fill:#1e40af,stroke:#3b82f6,color:#eff6ff
    style GAMES fill:#7c2d12,stroke:#ea580c,color:#fff7ed
    style DATA fill:#4c1d95,stroke:#8b5cf6,color:#f5f3ff
    style OV fill:#831843,stroke:#ec4899,color:#fdf2f8
