# ---------------------------------------------------------------------------
# FGDR — environment
# Copy to `.env.local` and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public origin of the site (used to build OAuth redirect URIs)
APP_URL=http://localhost:3000

# Signing key for the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# --- Database -------------------------------------------------------------
# Local dev: a file-backed libSQL database.
# Production: a Turso/libSQL URL (libsql://...) plus an auth token.
DATABASE_URL=file:./fgdr.db
DATABASE_AUTH_TOKEN=

# --- Discord OAuth2 (login) ----------------------------------------------
# https://discord.com/developers/applications -> OAuth2
# Redirect URI: ${APP_URL}/api/auth/discord/callback
# Scopes used: identify  (nothing else is requested or stored)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Kick (account linking + live status) --------------------------------
# https://kick.com/settings/developer
# Redirect URI: ${APP_URL}/api/auth/kick/callback
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# --- Access control -------------------------------------------------------
# Master admins: full control of the admin panel for all five channels and the
# whole site. "discordId:streamerSlug" ties the admin to their own channel.
# Held by fatguysdontrun, insanetigers7 and daddykonggaming.
# e.g. ADMIN_DISCORD_IDS=111111111111111111:fatguysdontrun,222222222222222222:insanetigers7,333333333333333333:daddykonggaming
ADMIN_DISCORD_IDS=

# Creators: manage their own channel's profile, schedule, clips, wins, raffles
# and challenges. Always "discordId:streamerSlug".
# Held by stillmakinggains and dallasghost.
# e.g. CREATOR_DISCORD_IDS=444444444444444444:stillmakinggains,555555555555555555:dallasghost
CREATOR_DISCORD_IDS=

# --- Wager leaderboards ---------------------------------------------------
# Two separate races with separate prizes: Stake.com and Stake.eu. Each board is
# pulled from that site's affiliate API every 5 min (keys start with "aff_").
STAKE_COM_API_KEY=
STAKE_EU_API_KEY=

# Optional. The affiliate API endpoints, if Stake's differ from these defaults:
#   https://stake.com/_api/affiliate/referrals
#   https://stake.eu/_api/affiliate/referrals
# The race window is sent as ?from=&to= (and startDate/endDate), ISO-8601 UTC.
STAKE_COM_API_URL=
STAKE_EU_API_URL=

# Fallback for the Stake.com board only, used while STAKE_COM_API_KEY is empty:
# the affiliate sheet's CSV export URL.
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv
LEADERBOARD_SHEET_URL=

# Only rows with this campaign_code are counted.
LEADERBOARD_CAMPAIGN_CODE=FGDR

# How often to re-pull, in milliseconds (minimum 30000).
LEADERBOARD_SYNC_INTERVAL_MS=300000

# Optional. When set, POST /api/leaderboard/sync requires
# "Authorization: Bearer <token>". Only needed for an external scheduler.
LEADERBOARD_SYNC_TOKEN=
