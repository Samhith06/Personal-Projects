# Copy to .env and fill in. `.env` is gitignored — never commit real keys.

# Site
APP_URL=http://localhost:3000
# Signs the session cookie. Required in production (any long random string).
AUTH_SECRET=
# Comma-separated Discord user IDs. owner = everything incl. unlocking Roobet names; admin = everything else; mod = queues only.
OWNER_DISCORD_IDS=
ADMIN_DISCORD_IDS=
MOD_DISCORD_IDS=

# Database (docker compose default)
DATABASE_URL=postgres://steezy:steezy@localhost:5432/steezy

# Discord OAuth — redirect URI: ${APP_URL}/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_INVITE_URL=https://discord.gg/PJpphDDS73
# Optional: channel webhook for "Steezy is live" posts.
DISCORD_LIVE_WEBHOOK_URL=
# Optional: #leaderboard channel webhook. After each Roobet sync, climbs in the live board's top places are posted there.
# The live board's top places are also posted there once a day, after this UTC hour.
LEADERBOARD_DAILY_HOUR_UTC=18
DISCORD_LEADERBOARD_WEBHOOK_URL=

# Kick OAuth — redirect URIs: ${APP_URL}/api/auth/kick/callback and ${APP_URL}/api/auth/kick/bot/callback
# Webhook URL (Kick developer settings): ${APP_URL}/api/webhooks/kick — then run `npm run kick:subscribe`
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Steezy's channel slug, e.g. kick.com/<slug>
KICK_CHANNEL_SLUG=

# Roobet affiliate API
ROOBET_API_URL=https://roobetconnect.com/affiliate/v2/stats
ROOBET_USER_ID=
ROOBET_API_KEY=
ROOBET_REFERRAL_URL=https://roobet.com/?ref=STZY
# How often to pull wagers, in ms (default 10 minutes).
ROOBET_SYNC_INTERVAL_MS=600000

# bonushunt.gg public API key (from your bonushunt.gg account, bonushunt.gg/api). Hunts are pulled every BONUSHUNT_SYNC_INTERVAL_MS (30 s).
BONUSHUNT_API_KEY=
BONUSHUNT_SYNC_INTERVAL_MS=30000
